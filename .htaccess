# Vietnam Unique Travel - Root Security & Rewrite Configuration
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block direct HTTP access to protected application folders and config files
    RewriteRule ^(app|config|database|lang|storage|vendor|views)/ - [F,L]
    RewriteRule ^(\.env|\.git|schema\.sql|seed\.sql|\.docx) - [F,L]

    # Forward all requests into public folder if accessed from root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
